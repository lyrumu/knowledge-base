{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "hugo --minify": "allow",
      "hugo --themesDir *": "ask",
      "hugo new *": "allow",
      "hugo version": "allow",
      "hugo server *": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "hugo --minify": "allow",
          "hugo new *": "allow",
          "hugo version": "allow",
          "hugo server *": "deny"
        }
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", ".git/**", "dist/**", "build/**", "*.log", ".hugo_build.lock"]
  },
  "command": {
    "newpost": {
      "template": "hugo new content/notes/{input}/index.md",
      "description": "新建 notes 文章（填 slug）",
      "agent": "build",
      "subtask": true
    }
  }
}
