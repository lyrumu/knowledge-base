/* =============================================================================
   lyrumu's site — 自定义 CSS（Blowfish 扩展点）
   加载方式：放在 assets/css/custom.css 会被自动打包进主 bundle
   ============================================================================= */

/* =============================================================================
   1. 字体优化（更舒服的阅读体验）
   ============================================================================= */
:root {
  --font-base: "Inter", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
               ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono: "JetBrains Mono", "Fira Code", ui-monospace, "Cascadia Code",
               "Source Code Pro", Menlo, Monaco, Consolas, monospace;
  --font-display: "Cal Sans", "Inter Display", var(--font-base);
}

html {
  font-feature-settings: "ss01", "cv11", "calt";
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body, .prose {
  font-family: var(--font-base);
  letter-spacing: -0.005em;
}

code, pre, kbd, samp {
  font-family: var(--font-mono);
  font-feature-settings: "calt" 0;
}

/* =============================================================================
   2. 封面页：隐藏顶栏 + 调整内容区
   （Blowfish 不给 homepage body 加 .home class，用 :has() 判断 .cover-page）
   ============================================================================= */
body:has(.cover-page) .fixed.inset-x-0.z-100 {
  display: none !important;
}

body:has(.cover-page) .min-h-\[148px\] {
  display: none !important;
}

body:has(.cover-page) main#main-content {
  padding-top: 0 !important;
}

body:has(.cover-page)>div.relative.flex.flex-col.grow {
  min-height: 0 !important;
}

body:has(.cover-page) main#main-content>article {
  max-width: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* =============================================================================
   3. 封面页：极光 + 噪点 + 内容
   ============================================================================= */
.cover-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  isolation: isolate;
}

/* --- 极光层（3 个浮动渐变球） --- */
.cover-aurora {
  position: absolute;
  inset: -10%;
  z-index: 0;
  pointer-events: none;
  filter: blur(80px) saturate(140%);
  opacity: 0.55;
}

.aurora-blob {
  position: absolute;
  border-radius: 50%;
  will-change: transform;
}

.aurora-blob-1 {
  width: 55vw;
  height: 55vw;
  top: -15%;
  left: -10%;
  background: radial-gradient(circle, #6366f1 0%, transparent 65%);
  animation: aurora-drift 22s ease-in-out infinite;
}

.aurora-blob-2 {
  width: 48vw;
  height: 48vw;
  top: 30%;
  right: -15%;
  background: radial-gradient(circle, #ec4899 0%, transparent 65%);
  animation: aurora-drift 26s ease-in-out infinite reverse;
  animation-delay: -7s;
}

.aurora-blob-3 {
  width: 42vw;
  height: 42vw;
  bottom: -15%;
  left: 30%;
  background: radial-gradient(circle, #14b8a6 0%, transparent 65%);
  animation: aurora-drift 30s ease-in-out infinite;
  animation-delay: -14s;
}

@keyframes aurora-drift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%      { transform: translate(8%, -6%) scale(1.08); }
  66%      { transform: translate(-6%, 8%) scale(0.95); }
}

/* --- 噪点叠加（grain） --- */
.cover-grain {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.06;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  background-size: 200px 200px;
}

/* --- 封面内容 --- */
.cover-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 2rem;
  animation: cover-fade-in 1s ease-out;
}

@keyframes cover-fade-in {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.cover-avatar {
  width: 7rem;
  height: 7rem;
  border-radius: 9999px;
  object-fit: cover;
  margin: 0 auto 2rem;
  border: 2px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
  animation: cover-fade-in 1.2s ease-out;
}

.cover-title {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 14vw, 9rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  margin: 0;
  line-height: 1;
  text-shadow: 0 4px 32px rgba(0, 0, 0, 0.4);
  background: linear-gradient(180deg, #ffffff 0%, #c0c8d4 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.cover-subtitle {
  font-size: clamp(0.95rem, 2vw, 1.35rem);
  font-weight: 300;
  letter-spacing: 0.05em;
  margin: 1.5rem 0 0;
  opacity: 0.9;
}

.cover-button {
  display: inline-block;
  margin-top: 3rem;
  padding: 0.95rem 2.75rem;
  border: 1.5px solid;
  border-radius: 9999px;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: transparent;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.cover-button::before {
  content: "";
  position: absolute;
  inset: 0;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: -1;
}

.cover-button:hover::before {
  transform: scaleX(1);
  transform-origin: left;
}

.cover-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(255, 255, 255, 0.12);
}

/* --- 社交链接（封面底部） --- */
.cover-social {
  margin-top: 3.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  animation: cover-fade-in 1.4s ease-out;
}

.cover-social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.cover-social-link:hover {
  transform: translateY(-3px) scale(1.08);
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.cover-decorations {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: -1;
}

/* =============================================================================
   4. 模块卡：玻璃拟态 + 悬浮 3D 倾斜
   ============================================================================= */
.module-card {
  position: relative;
  display: block;
  border-radius: 1rem;
  padding: 1.75rem;
  text-decoration: none !important;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              border-color 0.3s;
  transform-style: preserve-3d;
  will-change: transform;
  overflow: hidden;
}

.module-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--card-gradient, linear-gradient(135deg, transparent, transparent));
  opacity: 0.5;
  transition: opacity 0.3s;
  pointer-events: none;
}

.module-card:hover {
  transform: translateY(-4px) scale(1.01);
  border-color: rgba(255, 255, 255, 0.18);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
}

.module-card:hover::before {
  opacity: 0.8;
}

.module-card .module-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  font-size: 1.75rem;
  border-radius: 0.75rem;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 0.75rem;
}

.module-card .module-name {
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.module-card .module-title {
  font-size: 0.8rem;
  opacity: 0.6;
  margin-top: 0.15rem;
  font-family: var(--font-mono);
}

.module-card .module-desc {
  margin-top: 0.75rem;
  font-size: 0.9rem;
  line-height: 1.55;
  opacity: 0.85;
}

.module-card .module-cta {
  margin-top: 1rem;
  font-size: 0.8rem;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  opacity: 0.7;
  transition: gap 0.2s, opacity 0.2s;
}

.module-card:hover .module-cta {
  opacity: 1;
  gap: 0.6rem;
}

/* =============================================================================
   5. Vault 子分类卡（小一点的玻璃卡）
   ============================================================================= */
.vault-section-card {
  position: relative;
  display: block;
  border-radius: 0.875rem;
  padding: 1.25rem;
  text-decoration: none !important;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.07);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.vault-section-card:hover {
  transform: translateY(-2px);
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.06);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
}

/* =============================================================================
   6. 暗色 / 亮色模式适配
   ============================================================================= */
html:not(.dark) .module-card,
html:not(.dark) .vault-section-card {
  background: rgba(255, 255, 255, 0.55);
  border-color: rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
}

html:not(.dark) .cover-social-link {
  background: rgba(0, 0, 0, 0.04);
  border-color: rgba(0, 0, 0, 0.12);
}

/* =============================================================================
   7. 滚动出现动画（CSS scroll-driven animations，零 JS）
   ============================================================================= */
.reveal {
  /* 默认状态：可见（老浏览器降级） */
  opacity: 1;
}

@supports (animation-timeline: view()) {
  .reveal {
    animation: reveal-fade 1s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-timeline: view();
    animation-range: entry 0% cover 25%;
  }
}

@keyframes reveal-fade {
  from {
    opacity: 0;
    transform: translateY(28px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 传统 fallback：IntersectionObserver 启用时（由 reveal.js 控制） */
.no-scroll-timeline .reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}
.no-scroll-timeline .reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* =============================================================================
   8. 选区高亮（更柔和的颜色）
   ============================================================================= */
::selection {
  background: rgba(99, 102, 241, 0.4);
  color: inherit;
}
